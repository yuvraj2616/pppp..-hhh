#!/usr/bin/env bash
# Runs before every `git push` once scripts/setup-identity.sh has set core.hooksPath=.githooks.
# Blocks the push if any commit being pushed has an author outside the three participant identities.
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                 # deleting a remote branch: nothing to check
  if [ "$remote_sha" = "$zero" ]; then
    range=("$local_sha" --not --remotes)                  # new branch: only commits not on any remote yet
  else
    range=("$remote_sha..$local_sha")
  fi
  "$root/scripts/check-authors.sh" "${range[@]}" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: push blocked by the author check."
fi
exit "$status"
