# Copy to .env:  cp .env.example .env
MOCK_LLM=false
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=60

EMBED_MODEL=BAAI/bge-small-en-v1.5
CHUNK_STRATEGY=section
TOP_K=6

# Cloud fallback, OFF by default and disclosed in the README. Only read when LLM_PROVIDER is not ollama.
# CLOUD_API_KEY=
